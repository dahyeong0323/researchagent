{
  "name": "linkedin-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scout:local": "tsx src/research-agent/index.ts",
    "scout:url": "tsx src/research-agent/index.ts --url",
    "scout:rss": "tsx src/research-agent/index.ts --rss",
    "scout:local:llm": "tsx src/research-agent/index.ts --llm",
    "scout:notion": "tsx src/research-agent/index.ts --notion",
    "scout:feedback": "tsx src/research-agent/index.ts --feedback data/research-agent/feedback.sample.json",
    "export:selected": "tsx src/research-agent/export-to-writing.ts --feedback data/research-agent/feedback.sample.json",
    "export:selected:llm": "tsx src/research-agent/export-to-writing.ts --feedback data/research-agent/feedback.notion.json --llm",
    "feedback:notion": "tsx src/research-agent/sync-feedback-from-notion.ts",
    "notion:schema:check": "tsx src/research-agent/notion-schema-cli.ts --check",
    "notion:schema:update": "tsx src/research-agent/notion-schema-cli.ts --update",
    "telegram:poll": "tsx src/research-agent/telegram-poll.ts",
    "telegram:test": "tsx src/research-agent/telegram-test.ts",
    "daily": "tsx src/research-agent/daily.ts",
    "daily:dry": "tsx src/research-agent/daily.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
