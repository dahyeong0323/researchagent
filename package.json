{
  "name": "linkedin-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scout:local": "tsx src/research-agent/index.ts",
    "scout:local:llm": "tsx src/research-agent/index.ts --llm",
    "scout:notion": "tsx src/research-agent/index.ts --notion",
    "scout:feedback": "tsx src/research-agent/index.ts --feedback data/research-agent/feedback.sample.json",
    "export:selected": "tsx src/research-agent/export-to-writing.ts --feedback data/research-agent/feedback.sample.json",
    "feedback:notion": "tsx src/research-agent/sync-feedback-from-notion.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
